# Tamakkan frontend - copy to `.env` (git-ignored) next to docker-compose.yml. Both values are read at RUNTIME on the server
# only (BFF route handlers, lib/api/server/backend.ts); nothing here is sent to the browser and nothing is a build argument.
# Avatar Practice needs no frontend setting: the browser gets its SpatialReal App ID, Avatar ID and a short-lived session
# token from the backend per session.

# REQUIRED. Backend base URL INCLUDING its API prefix. Same VPS as the backend (docker-compose.yml: it publishes
# 127.0.0.1:4652 and this container reaches it through host.docker.internal):
API_BASE_URL=http://host.docker.internal:4652/api/v1

# Prefix of the login cookie names (<prefix>_access_token / <prefix>_refresh_token). Lowercase letters, digits, underscore.
# Changing it signs every user out once, and two apps on one host need different values. Unset = "tamakkan".
AUTH_COOKIE_PREFIX=tamakkan
