audit=false
fund=false
update-notifier=false
cache=.sites-runtime/npm-cache
# Peer dependencies are deliberately NOT auto-installed. Without this flag npm resolves the optional peers of next /
# @spatialreal/web-sdk by pulling in ~40 extra packages (webpack and friends) that a vinext/vite app never uses, and
# the project was installed this way from the start (see package-lock.json). It was originally also needed because the
# legacy AvatarKit package pinned a `vite@^5` peer; that package is gone, the flag stays for the reason above.
legacy-peer-deps=true
